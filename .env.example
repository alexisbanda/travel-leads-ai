# Variables de entorno de desarrollo local con los emuladores de Firebase.
# Copia este archivo a .env.local y no subas valores reales de producción.

# Instancia activa (agencia × destino × mercado). Ver instances/<id>/instance.yaml.
INSTANCE=ec-es

# Host del emulador de Firestore (ver "firebase emulators:start").
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Proyecto de Firebase usado por los emuladores en local.
GCLOUD_PROJECT=tla-ec-es-dev
