.next/
out/
*.tsbuildinfo

# Lo genera scripts/sync-media.mjs (predev/prebuild) desde
# instances/<id>/content/media; no son medios del motor.
public/media/

# El .gitignore raíz ignora cualquier carpeta `lib/` (salida de build de
# functions); aquí `lib/` es código fuente (ver AGENTS.md, apps/landings/lib).
!lib/
!lib/**

# Lo genera Next (`next typegen`, `next dev`, `next build`) con rutas a .next/types.
next-env.d.ts
