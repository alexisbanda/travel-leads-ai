{
  "name": "travel-leads-ai",
  "private": true,
  "description": "Motor de captación y calificación de leads para agencias de viajes receptivas, configurable por instancia (agencia × destino × mercado).",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:emulator": "pnpm -r --if-present run test:emulator",
    "evals": "pnpm -r --if-present run evals",
    "instance:validate": "pnpm --filter @tla/instance-cli --silent validate",
    "instance:build": "pnpm --filter @tla/instance-cli --silent instance:build",
    "instance:seed": "pnpm --filter @tla/instance-cli --silent instance:seed",
    "deploy:instance": "echo \"Pendiente (M0): despliega una instancia\" && exit 1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
